# Copy this file to .env in the same folder and fill in real values.
# Never commit the real .env, it's already excluded in .gitignore.

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery dataset created by setup/setup_bigquery.sh
BIGQUERY_DATASET=zomato_agent_data
BIGQUERY_TABLE=restaurants

# Create this in Google Cloud Console > APIs & Services > Credentials,
# scoped to the Maps/Places APIs enabled in setup/setup_env.sh
MAPS_API_KEY=your-maps-api-key

# Which Gemini model the agent uses
GEMINI_MODEL=gemini-3.1-pro-preview
